#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034

description="MSM8916 configfs USB RNDIS gadget"

depend() {
	need localmount networkmanager
	after modules udev-trigger
	before sshd
}

start() {
	ebegin "Creating the MSM8916 USB RNDIS gadget"
	/usr/sbin/usb-gadget-rndis start
	eend $?
}

stop() {
	ebegin "Removing the MSM8916 USB RNDIS gadget"
	/usr/sbin/usb-gadget-rndis stop
	eend $?
}
