[Unit]
Description=MSM8916 configfs USB RNDIS gadget
Wants=NetworkManager.service
After=local-fs.target sys-kernel-config.mount NetworkManager.service
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/usb-gadget-rndis start
ExecStop=/usr/sbin/usb-gadget-rndis stop

[Install]
WantedBy=multi-user.target
