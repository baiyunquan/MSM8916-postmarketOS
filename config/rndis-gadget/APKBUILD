# Maintainer: baiyunquan <baiyunquan@users.noreply.github.com>
pkgname=postmarketos-msm8916-rndis-gadget
pkgver=1
pkgrel=0
pkgdesc="OpenRC USB RNDIS gadget for the MSM8916 multi-board image"
url="https://github.com/baiyunquan/MSM8916-postmarketOS"
arch="noarch"
license="MIT"
depends="
	kmod
	networkmanager
	networkmanager-cli
	networkmanager-dnsmasq
	openrc
	"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	usb-gadget-rndis
	usb-gadget-rndis.initd
	usb-gadget-rndis.nmconnection
	90-msm8916-rndis.conf
	99-msm8916-rndis.rules
	"

package() {
	install -Dm755 "$srcdir/usb-gadget-rndis" \
		"$pkgdir/usr/sbin/usb-gadget-rndis"
	install -Dm755 "$srcdir/usb-gadget-rndis.initd" \
		"$pkgdir/etc/init.d/usb-gadget-rndis"
	install -Dm600 "$srcdir/usb-gadget-rndis.nmconnection" \
		"$pkgdir/etc/NetworkManager/system-connections/usb-gadget-rndis.nmconnection"
	install -Dm644 "$srcdir/90-msm8916-rndis.conf" \
		"$pkgdir/etc/NetworkManager/conf.d/90-msm8916-rndis.conf"
	install -Dm644 "$srcdir/99-msm8916-rndis.rules" \
		"$pkgdir/etc/udev/rules.d/99-msm8916-rndis.rules"
}

